        "policy": "not-applicable",
        "engines": [],
        "command_ids": []
      },
      "cross_engine": {
        "policy": "not-applicable",
        "engines": [],
        "command_ids": [],
        "installation": {
          "policy": "none",
          "command_ids": []
        }
      }
    }
  },
  "publication": {
    "mode": "manual",
