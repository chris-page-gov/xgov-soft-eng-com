  "boundaries": {
    "authored": [
      {
        "path": "README.md",
        "role": "documentation"
      },
      {
        "path": "docs/**",
        "role": "documentation"
      },
      {
        "path": "CHANGELOG.md",
        "role": "changelog"
      },
      {
        "path": "config/**",
        "role": "policy"
      },
      {
        "path": "schemas/**",
        "role": "schema"
      },
      {
        "path": "scripts/**",
        "role": "generator"
      },
      {
        "path": "tests/**",
        "role": "test"
      },
      {
        "path": "okf.*.json",
        "role": "policy"
      },
      {
        "path": ".github/workflows/**",
        "role": "workflow"
      },
      {
        "path": "source/**",
        "role": "source-envelope"
      }
    ],
    "generated": [
      {
        "path": "generated/**",
        "role": "explorer-runtime",
        "plane": "runtime",
        "required": true,
        "build_command_ids": [
          "build"
        ],
        "check_command_ids": [
          "check",
          "assure"
        ]
      },
      {
        "path": "dist/**",
        "role": "release-pack",
        "plane": "release",
        "required": false,
        "build_command_ids": [
          "archive"
        ],
        "check_command_ids": [
          "check",
          "assure"
        ]
      }
    ]
  },
  "planes": [
    {
      "id": "source",
      "depends_on": [],
      "paths": [
        "source/**"
      ],
      "command_ids": [
        "refresh"
      ]
    },
    {
      "id": "runtime",
      "depends_on": [
        "source"
      ],
      "paths": [
        "config/**",
        "scripts/**",
        "schemas/**",
        "tests/**",
        "generated/**"
      ],
      "command_ids": [
        "tests",
        "build",
        "check",
        "assure"
      ]
    },
    {
      "id": "documentation",
      "depends_on": [
        "runtime"
      ],
      "paths": [
        "*.md",
        "docs/**"
      ],
      "command_ids": [
        "check"
      ]
    },
    {
      "id": "release",
      "depends_on": [
        "runtime",
        "documentation"
      ],
      "paths": [
        "dist/**",
        ".github/workflows/**"
      ],
      "command_ids": [
        "archive"
      ]
    }
  ],
  "tooling": {
    "commands": [
      {
        "id": "refresh",
        "kind": "build",
        "planes": [
          "source"
        ],
        "command": "uv run --locked python scripts/catalogue.py refresh",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "acquisition",
        "mutates": "source-and-generated",
        "timeout_minutes": 10
      },
      {
        "id": "build",
        "kind": "build",
        "planes": [
          "runtime"
        ],
        "command": "uv run --locked python scripts/catalogue.py build",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "generated-only",
        "timeout_minutes": 10
      },
      {
        "id": "check",
        "kind": "check",
        "planes": [
          "runtime"
        ],
        "command": "uv run --locked python scripts/catalogue.py check",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 10
      },
      {
        "id": "tests",
        "kind": "check",
        "planes": [
          "runtime"
        ],
        "command": "uv run --locked python -m unittest discover -s tests -v",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 10
      },
      {
        "id": "assure",
        "kind": "check",
        "planes": [
          "runtime"
        ],
        "command": "python scripts/assure.py",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 10
      },
      {
        "id": "archive",
        "kind": "build",
        "planes": [
          "release"
        ],
        "command": "uv run --locked python scripts/archive.py",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "generated-only",
        "timeout_minutes": 10
      }
    ]
  },
  "lockstep": {
    "controlled_paths": [
      "source/**",
      "config/**",
      "scripts/**",
      "schemas/**",
