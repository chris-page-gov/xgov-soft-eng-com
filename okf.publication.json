      "origin": "acquired",
      "authority": "external-reference",
      "snapshot_policy": "immutable-checksummed",
      "inventory": {
        "method": "content-addressed-manifest",
        "manifest_path": "source/current.json",
        "identity": [
          "relative-path",
          "sha256",
          "source-identifier",
          "observed-at"
        ]
      },
      "rights": {
        "status": "mixed",
        "evidence": [
          "https://github.com/uk-x-gov-software-community/xgov-opensource-repo-scraper/blob/master/LICENSE",
          "https://github.com/chris-page-gov/xgov-soft-eng-com/blob/main/LICENSE_DECISIONS.md"
        ]
      },
      "sensitivity": {
        "status": "potentially-sensitive",
        "assessment": "Public GitHub identifiers and descriptions may refer to individuals. Only the requested public sources and minimal review metadata are admitted.",
        "evidence": [
          "https://github.com/chris-page-gov/xgov-soft-eng-com/blob/main/source/README.md"
        ]
      },
      "extraction": {
        "mode": "versioned-adapter",
        "network_access": "separate-authorised-step",
        "command_ids": [
          "refresh"
        ],
        "limitations": [
          "No catalogued code execution.",
          "Optional SBOM paths do not establish completeness or freshness."
        ]
      },
      "invalidates": [
        "source",
        "semantic",
        "runtime",
        "documentation"
      ],
      "limitations": [
        "Not all community guidance is in this feed."
      ]
    },
    {
      "id": "public-review-evidence",
      "label": "Dated security helper and issue review",
      "kind": "mixed",
      "paths": [
        "source/security-helper-inventory.json",
        "source/contributors-inventory.json",
        "source/upstream/**",
        "source/sbom-review/*.receipt.json",
        "source/sbom-review/sds-addresses.json.gz"
      ],
      "formats": [
        "application/json",
        "text/plain"
      ],
      "origin": "acquired",
      "authority": "external-reference",
      "snapshot_policy": "immutable-checksummed",
      "extraction": {
        "mode": "manual-reviewed",
        "network_access": "prohibited",
        "command_ids": []
      },
      "limitations": [
        "Dated contributor, security helper and issue review; not a vulnerability audit."
      ],
      "inventory": {
        "method": "pinned-source-register",
        "manifest_path": "source/security-helper-inventory.json",
        "identity": [
          "relative-path",
          "sha256",
          "source-identifier",
          "observed-at"
        ]
      },
      "rights": {
        "status": "mixed",
        "evidence": [
          "https://github.com/uk-x-gov-software-community/xgov-opensource-repo-scraper/blob/master/LICENSE",
          "https://github.com/chris-page-gov/xgov-soft-eng-com/blob/main/LICENSE_DECISIONS.md"
        ]
      },
      "sensitivity": {
        "status": "potentially-sensitive",
        "assessment": "Public GitHub identifiers and descriptions may refer to individuals. Only the requested public sources and minimal review metadata are admitted.",
        "evidence": [
          "https://github.com/chris-page-gov/xgov-soft-eng-com/blob/main/source/README.md"
        ]
      },
      "invalidates": [
        "source",
        "semantic",
        "runtime",
        "documentation"
      ]
    },
    {
      "id": "public-sbom-quality",
      "label": "Public SBOM quality counters",
      "description": "Frozen, checksummed upstream version-resolution and dependency-context counters, not an advisory scan.",
      "kind": "json",
      "paths": [
        "source/snapshots/*.sbom-quality.json",
        "source/sbom-review/sbom-quality.json"
      ],
      "formats": [
        "application/json"
      ],
      "origin": "acquired",
      "authority": "external-reference",
      "snapshot_policy": "immutable-checksummed",
      "inventory": {
        "method": "content-addressed-manifest",
        "manifest_path": "source/current.json",
        "identity": [
          "relative-path",
          "sha256",
          "source-identifier",
          "observed-at"
        ]
      },
      "rights": {
        "status": "mixed",
        "evidence": [
          "https://github.com/uk-x-gov-software-community/xgov-opensource-repo-scraper/blob/master/LICENSE",
          "https://github.com/chris-page-gov/xgov-soft-eng-com/blob/main/LICENSE_DECISIONS.md"
        ]
      },
      "sensitivity": {
        "status": "potentially-sensitive",
        "assessment": "Public GitHub identifiers and descriptions may refer to individuals. Only the requested public sources and minimal review metadata are admitted.",
        "evidence": [
          "https://github.com/chris-page-gov/xgov-soft-eng-com/blob/main/source/README.md"
        ]
      },
      "extraction": {
        "mode": "versioned-adapter",
        "network_access": "separate-authorised-step",
        "command_ids": [
          "refresh"
        ],
        "limitations": [
          "Heuristic runtime exclusions do not establish deployment or vulnerability applicability."
        ]
      },
      "invalidates": [
        "source",
        "semantic",
        "runtime",
        "documentation"
      ],
      "limitations": [
        "Package counters are observations, not deduplicated deployed dependencies."
      ]
    },
    {
      "id": "public-contributor-history",
      "label": "Public repository contributor statistics",
      "description": "Bounded full-catalogue collection of all available default-branch weekly contributor statistics.",
      "kind": "api",
      "paths": [
        "source/history/index.json",
        "source/history/observations/*.json"
      ],
      "formats": [
        "application/json"
      ],
      "origin": "acquired",
      "authority": "external-reference",
      "snapshot_policy": "content-addressed",
      "inventory": {
        "method": "content-addressed-manifest",
        "manifest_path": "source/history/index.json",
        "identity": [
          "relative-path",
          "sha256",
          "source-identifier",
          "observed-at"
        ]
      },
      "rights": {
        "status": "mixed",
        "evidence": [
          "https://docs.github.com/en/site-policy/github-terms/github-terms-of-service"
        ]
      },
      "sensitivity": {
        "status": "potentially-sensitive",
        "assessment": "Public account handles and contribution counts may identify individuals. Emails and unrelated profile data are excluded.",
        "evidence": [
          "https://github.com/chris-page-gov/xgov-soft-eng-com/blob/main/source/README.md"
        ]
      },
      "extraction": {
        "mode": "versioned-adapter",
        "network_access": "separate-authorised-step",
        "command_ids": [
          "history"
        ],
        "limitations": [
          "No source-code execution; minimal public account identifiers and counts only."
        ]
      },
      "invalidates": [
        "source",
        "semantic",
        "runtime",
        "documentation"
      ],
      "limitations": [
        "Collection coverage is explicit; provider-pending data are not zero activity.",
        "Default-branch statistics exclude some commit kinds and can omit line counts.",
        "Accounts and counts do not establish ownership, maintainership or quality."
      ]
    }
  ],
  "boundaries": {
    "authored": [
      {
        "path": "README.md",
        "role": "documentation"
      },
      {
        "path": "docs/**",
        "role": "documentation"
      },
      {
        "path": "CHANGELOG.md",
        "role": "changelog"
      },
      {
        "path": "config/**",
        "role": "policy"
      },
      {
        "path": "schemas/**",
        "role": "schema"
      },
      {
        "path": "scripts/**",
        "role": "generator"
      },
      {
        "path": "tests/**",
        "role": "test"
      },
      {
        "path": "okf.*.json",
        "role": "policy"
      },
      {
        "path": ".github/workflows/**",
        "role": "workflow"
      },
      {
        "path": "source/**",
        "role": "source-envelope"
      }
    ],
    "generated": [
      {
        "path": "generated/**",
        "role": "explorer-runtime",
        "plane": "runtime",
        "required": true,
        "build_command_ids": [
          "build"
        ],
        "check_command_ids": [
          "check",
          "assure"
        ]
      },
      {
        "path": "dist/**",
        "role": "release-pack",
        "plane": "release",
        "required": false,
        "build_command_ids": [
          "archive"
        ],
        "check_command_ids": [
          "check",
          "assure"
        ]
      },
      {
        "path": "validation/browser/**",
        "role": "browser-receipt",
        "plane": "browser",
        "required": false,
        "build_command_ids": [
          "browser"
        ],
        "check_command_ids": [
          "browser"
        ]
      }
    ]
  },
  "planes": [
    {
      "id": "source",
      "depends_on": [],
      "paths": [
        "source/**"
      ],
      "command_ids": [
        "refresh",
        "history"
      ]
    },
    {
      "id": "runtime",
      "depends_on": [
        "source"
      ],
      "paths": [
        "config/**",
        "scripts/**",
        "schemas/**",
        "tests/**",
        "generated/**"
      ],
      "command_ids": [
        "tests",
        "build",
        "check",
        "assure"
      ]
    },
    {
      "id": "documentation",
      "depends_on": [
        "runtime"
      ],
      "paths": [
        "*.md",
        "docs/**"
      ],
      "command_ids": [
        "check"
      ]
    },
    {
      "id": "release",
      "depends_on": [
        "runtime",
        "documentation"
      ],
      "paths": [
        "dist/**",
        ".github/workflows/**"
      ],
      "command_ids": [
        "archive",
        "ai-evaluation"
      ]
    },
    {
      "id": "browser",
      "depends_on": [
        "runtime"
      ],
      "paths": [
        "scripts/browser_acceptance.js",
        "output/playwright/**",
        "validation/browser/**"
      ],
      "command_ids": [
        "browser",
        "browser-receipts"
      ]
    },
    {
      "id": "deployment",
      "depends_on": [
        "release"
      ],
      "paths": [
        "dist/pages/**",
        ".github/workflows/pages.yml"
      ],
      "command_ids": [
        "pages-candidate"
      ]
    }
  ],
  "tooling": {
    "commands": [
      {
        "id": "refresh",
        "kind": "build",
        "planes": [
          "source"
        ],
        "command": "uv run --locked python scripts/catalogue.py refresh",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "acquisition",
        "mutates": "source-and-generated",
        "timeout_minutes": 10
      },
      {
        "id": "build",
        "kind": "build",
        "planes": [
          "runtime"
        ],
        "command": "uv run --locked python scripts/catalogue.py build",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "generated-only",
        "timeout_minutes": 10
      },
      {
        "id": "check",
        "kind": "check",
        "planes": [
          "runtime"
        ],
        "command": "uv run --locked python scripts/catalogue.py check",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 10
      },
      {
        "id": "tests",
        "kind": "check",
        "planes": [
          "runtime"
        ],
        "command": "uv run --locked python -m unittest discover -s tests -v",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 10
      },
      {
        "id": "assure",
        "kind": "check",
        "planes": [
          "runtime"
        ],
        "command": "python scripts/assure.py",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 10
      },
      {
        "id": "archive",
        "kind": "build",
        "planes": [
          "release"
        ],
        "command": "uv run --locked python scripts/archive.py",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "generated-only",
        "timeout_minutes": 10
      },
      {
        "id": "history",
        "kind": "build",
        "planes": [
          "source"
        ],
        "command": "uv run --locked python scripts/history.py collect --limit 500 --request-budget 1800 --max-seconds 1500",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "acquisition",
        "mutates": "source-and-generated",
        "timeout_minutes": 30
      },
      {
        "id": "pages-candidate",
        "kind": "build",
        "planes": [
          "release",
          "deployment"
        ],
        "command": "uv run --locked python scripts/pages.py",
        "source": "scripts/pages.py",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "generated-only"
      },
      {
        "id": "browser",
        "kind": "verify",
        "planes": [
          "browser"
        ],
        "command": "playwright-cli --session xgov-acceptance run-code --filename scripts/browser_acceptance.js",
        "source": "docs/browser-acceptance.md",
        "review_status": "reviewed-local-guidance",
        "network": "bounded-read",
        "mutates": "generated-only"
      },
      {
        "id": "browser-receipts",
        "kind": "verify",
        "planes": [
          "browser"
        ],
        "command": "python scripts/collect_browser_receipts.py --manifest release/build-manifest.json --logs output/playwright/ci --output output/playwright/ci/browser-verification.json",
        "source": "scripts/collect_browser_receipts.py",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "generated-only"
      },
      {
        "id": "ai-evaluation",
        "kind": "check",
        "planes": [
          "release"
        ],
        "command": "uv run --locked python scripts/verify_bundle.py --archive dist/xgov-okf.tar.gz --checksums dist/SHA256SUMS --output dist/verification-result.json",
        "source": "docs/ai-evaluation.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "generated-only"
      }
    ]
  },
  "lockstep": {
    "controlled_paths": [
      "source/**",
      "config/**",
      "scripts/**",
      "schemas/**",
      "tests/**",
      ".github/workflows/**",
      "okf.*.json",
      "requirements-assurance.txt"
    ],
    "documentation_paths": [
      "README.md",
      "docs/**",
      "REPOSITORY_STATUS.md",
      "CHANGELOG.md"
    ],
    "changelog_path": "CHANGELOG.md",
    "check_command_id": "check",
    "dependency_update_policy": "assess-release-bound-bytes-no-blanket-exemption",
    "unknown_path_policy": "fail-closed"
  },
  "ci": {
    "provider": "github-actions",
    "workflow_paths": [
      ".github/workflows/validate.yml",
      ".github/workflows/refresh.yml",
      ".github/workflows/history.yml",
      ".github/workflows/pages.yml"
    ],
    "impact_routing": "full-suite",
    "parallelism": "serial",
    "unknown_path_policy": "full-suite",
    "browser": {
      "ordinary": {
        "policy": "installed-chrome",
        "engines": [
          "chrome"
        ],
        "command_ids": [
          "browser",
          "browser-receipts"
        ]
      },
      "cross_engine": {
        "policy": "not-applicable",
        "engines": [],
        "command_ids": [],
        "installation": {
          "policy": "none",
          "command_ids": []
        }
      }
    }
  },
  "publication": {
    "mode": "manual",
    "scope": "public-release",
    "authority": {
      "decision": "Owner explicitly authorised a public GitHub repository and regularly updated experiment on 28 October 2026.",
      "evidence_paths": [
        "REPOSITORY_STATUS.md"
      ]
    },
    "candidate_policy": "promote-exact-assured-bytes-without-rebuild",
    "targets": [
      {
        "id": "github-snapshots",
        "kind": "github-release",
        "workflow_path": ".github/workflows/refresh.yml",
        "public_base_url": "https://github.com/chris-page-gov/xgov-soft-eng-com/releases",
        "exact_commit_required": true,
        "promote_without_rebuild": true
      },
      {
        "id": "github-pages",
        "kind": "github-pages",
        "workflow_path": ".github/workflows/pages.yml",
        "public_base_url": "https://chris-page-gov.github.io/xgov-soft-eng-com/",
        "exact_commit_required": true,
        "promote_without_rebuild": true
      }
    ]
  },
  "verification": {
    "required": true,
    "browser": "real-browser",
    "exact_commit_required": true,
    "identity_checks": [
      "commit",
      "snapshot",
      "sha256",
      "record-count",
      "descriptor",
      "route"
    ],
    "journeys": [
      {
        "id": "public-catalogue",
        "url": "https://chris-page-gov.github.io/okf-explorer/explore/?bundle=https%3A%2F%2Fchris-page-gov.github.io%2Fxgov-soft-eng-com%2Fokf-explorer.json",
        "expected_identity": "The assured producer descriptor, snapshot, record count and deployed Explorer application tree",
        "steps": [
          "Load the exact Pages descriptor in ordinary Chrome.",
          "Select All facets and verify each of the 25 dimensions against the checked catalogue distributions.",
          "Verify exact-name and zero-result search, semantic links, inverse navigation, source provenance and repository history.",
          "Confirm no browser errors or failed requests."
        ]
      }
    ],
    "console_policy": "no-errors",
    "command_ids": [
      "tests",
      "check",
      "assure",
      "browser",
      "browser-receipts"
    ]
  },
  "limitations": [
    "No vulnerability scan or private report access.",
    "Scheduled executions may be delayed by GitHub.",
    "Publication-method v1 has no scheduled-release mode: manual denotes invocation of reviewed release commands; the separate CI workflow declares the automatic schedule. No repository branch protection is claimed.",
    "Pages runs the three ordinary-Chrome suites after deployment. This producer workflow does not claim cross-engine or human usability acceptance. A post-deployment failure requires investigation; no automatic rebuild or rollback is performed."
  ]
}
