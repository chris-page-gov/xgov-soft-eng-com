        },
        {
          "line": 18,
          "text": "  sbom:"
        },
        {
          "line": 34,
          "text": "      - name: Restore SBOM cache"
        },
        {
          "line": 37,
          "text": "          path: sbom-cache/"
        },
        {
          "line": 38,
          "text": "          key: sbom-cache-${{ github.run_id }}"
        },
        {
          "line": 40,
          "text": "            sbom-cache-"
        },
        {
          "line": 41,
          "text": "      - name: Merge supplementary SBOM cache (if available)"
        },
        {
          "line": 43,
          "text": "          if gh release download sbom-supplement -p 'sbom-supplement.tar.gz' -D /tmp 2>/dev/null; then"
        },
        {
          "line": 45,
          "text": "            mkdir -p /tmp/sbom-supplement"
        },
        {
          "line": 46,
          "text": "            tar -xzf /tmp/sbom-supplement.tar.gz -C /tmp/sbom-supplement"
        },
        {
          "line": 47,
          "text": "            node index.js merge-sbom-cache --primary ./sbom-cache --supplement /tmp/sbom-supplement"
        },
        {
          "line": 48,
          "text": "            rm -rf /tmp/sbom-supplement /tmp/sbom-supplement.tar.gz"
        },
        {
          "line": 54,
          "text": "      - name: Fetch SBOMs (incremental)"
        },
        {
          "line": 55,
          "text": "        run: node index.js fetch-sboms --repos-file ./repos.json --cache-dir ./sbom-cache --budget 95 --max-hours 1"
        },
        {
          "line": 61,
          "text": "          node index.js publish-sboms --repos-file ./public/repos.json --cache-dir ./sbom-cache --output-dir ./public"
        }
      ],
      "error": false
