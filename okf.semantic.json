{
  "schema": "okf-repository-semantic-contract.v2",
  "repository": {
    "name": "xgov-soft-eng-com",
    "role": "large-corpus-producer",
    "root_index": "generated/index.md"
  },
  "okf_core": {
    "version": "0.3",
    "specification": "https://github.com/open-knowledge-format/open-knowledge-format/blob/527e81aff55992be21507e97004286789126f88c/SPEC.md",
    "status": "migration"
  },
  "semantic_layer": {
    "profile": "https://github.com/chris-page-gov/xgov-soft-eng-com/blob/main/profiles/xgov-software/v2/index.md",
    "state": "generated-json-ld-graph",
    "authoritative_inputs": [
      "source/current.json",
      "source/snapshots/*.json",
      "source/published-inputs-2026-10-29.json",
      "source/history/index.json",
      "source/history/observations/*.json",
      "config/*.json",
      "schemas/*.json",
      "profiles/xgov-software/v2/index.md"
    ],
    "outputs": [
      {
        "path": "generated/semantic/*.jsonld.gz",
        "role": "semantic-json-ld-shards",
        "generated": true
      },
      {
        "path": "generated/semantic/manifest.json",
        "role": "semantic-manifest",
        "generated": true
      },
      {
        "path": "generated/okf-explorer.json",
        "role": "explorer-runtime",
        "generated": true
      },
      {
        "path": "generated/okf-core-explorer.json",
        "role": "explorer-runtime",
        "generated": true
      },
      {
        "path": "generated/concepts/**/*.md",
        "role": "semantic-yaml-ld",
        "generated": true
      },
      {
        "path": "generated/source/taxonomy.json",
        "role": "explorer-runtime",
        "generated": true
      },
      {
        "path": "generated/walkthrough/**",
        "role": "semantic-validation",
        "generated": true
      },
      {
        "path": "generated/index.md",
        "role": "semantic-yaml-ld",
        "generated": true
      },
      {
        "path": "generated/data/assertions-*.json.gz",
        "role": "relationship-runtime",
        "generated": true
      }
    ],
    "context_policy": "pinned-local-contexts-no-browser-remote-expansion",
    "identity_policy": "absolute-semantic-iri-plus-validated-local-route",
    "limitations": [
    "Producer-specific experimental profile; the shared contract schema does not establish full Bundle Wiki v2 conformance.",
      "Rules describe names and descriptions, not repository code; labels are unreviewed.",
      "Historical and recent contributor relationships describe available GitHub default-branch statistics, not ownership or maintainership.",
      "Semantic manifest snapshot retains its source-feed IRI for compatibility; build_id identifies the complete bundle. Predicate usage labels are local presentation metadata."
    ]
  },
  "relationship_contract": {
    "schema": "urn:okf:xgov:schema:assertion:1",
    "authoring": "generated-rdf-graph-with-runtime-assertions",
    "direct_triple_policy": "generated-from-one-assertion-source-across-pinned-shards",
    "predicate_policy": "absolute-iri",
    "required_fields": [
      "id",
      "source",
      "target",
      "source_iri",
      "target_iri",
      "predicate",
      "kind",
      "label",
      "inverse_label",
      "assertion_status",
      "assertion_scope",
      "authority",
      "derivation",
      "observed_at",
      "evidence",
      "rights"
    ]
  },
  "tooling": {
    "setup": [
      "uv sync --locked"
    ],
    "build": [
      "uv run --locked python scripts/hydrate_published_inputs.py --output $RUNNER_TEMP/xgov-published-inputs",
      "uv run --locked python scripts/catalogue.py --inputs-root $RUNNER_TEMP/xgov-published-inputs build"
    ],
    "check": [
      "uv run --locked python scripts/hydrate_published_inputs.py --output $RUNNER_TEMP/xgov-published-inputs --copy-archive-to $RUNNER_TEMP/xgov-published-inputs.tar.gz",
      "uv run --locked python scripts/catalogue.py --inputs-root $RUNNER_TEMP/xgov-published-inputs check",
      "uv run --locked python -m unittest discover -s tests -v",
      "uv run --locked python scripts/check_core_projection.py",
      "uv run --locked python scripts/check_migration_parity.py --reference-archive $RUNNER_TEMP/xgov-published-inputs.tar.gz",
      "uv run --locked python scripts/archive.py --inputs-root $RUNNER_TEMP/xgov-published-inputs",
      "uv run --locked --group assurance python scripts/assure.py",
      "uv run --locked python scripts/check_repository_protection.py --local",
      "pnpm --dir .ci/okf-explorer/apps/okf-explorer acceptance:bundle -- --bundle-root generated --journeys validation/browser/xgov-metadata-journeys.json --output $RUNNER_TEMP/xgov-explorer-metadata-acceptance.json --port 4292",
      "pnpm --dir .ci/okf-explorer/apps/okf-explorer acceptance:bundle -- --bundle-root generated --journeys validation/browser/xgov-core-journeys.json --output $RUNNER_TEMP/xgov-explorer-core-acceptance.json --port 4293"
    ]
  },
  "reader": {
    "consumer": "https://chris-page-gov.github.io/okf-explorer/",
    "delivery": "json-large-corpus-chunks",
    "preserves": [
      "direction",
      "semantic-identities",
      "local-routes",
      "predicate",
      "relationship-kind",
      "preferred-and-inverse-labels",
      "assertion-status-and-scope",
      "authority",
      "derivation",
      "supporting-assertions",
      "confidence",
      "review-status",
      "evidence",
      "rights",
      "freshness",
      "lifecycle"
    ]
  }
}
