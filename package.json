{
  "name": "xgov-soft-eng-com-browser-acceptance",
  "version": "1.0.0",
  "private": true,
  "description": "Locked browser acceptance tooling for the public catalogue",
  "engines": {
    "node": "26.7.0",
    "npm": "11.19.0"
  },
